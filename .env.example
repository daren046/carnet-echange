# Copier vers backend/.env ou définir comme variables d'environnement système

# Secret JWT Base64 (256 bits) — OBLIGATOIRE en production
# Générer : openssl rand -base64 32
JWT_SECRET=

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/carnetechange
DATABASE_USER=carnet
DATABASE_PASSWORD=carnet123

# Render — URL du frontend (CORS), séparer par des virgules si plusieurs
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Render frontend build (frontend/.env)
# VITE_API_URL=https://carnet-echange-api.onrender.com/api/v1
